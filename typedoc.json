{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["lib", "types", "components"],
  "entryPointStrategy": "expand",
  "out": "docs-autogen",
  "exclude": [
    "**/node_modules/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/tests/**"
  ],
  "plugin": ["typedoc-plugin-markdown"],
  "readme": "README.md",
  "githubPages": false,
  "navigation": {
    "includeCategories": true,
    "includeGroups": true,
    "includeFolders": true
  },
  "categorizeByGroup": true,
  "groupOrder": [
    "Generator",
    "Templates",
    "Utilities",
    "Types",
    "*"
  ],
  "sort": ["source-order"],
  "kindSortOrder": [
    "Class",
    "Interface",
    "TypeAlias",
    "Function",
    "Variable"
  ],
  "includeVersion": true,
  "cleanOutputDir": true
}
