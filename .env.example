# Claude API Configuration
ANTHROPIC_API_KEY=sk-ant-xxxxx
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Mode NO_AI (pour tests et développement)
# Si défini à "true", aucun appel à l'API Anthropic ne sera effectué
# Le contenu sera généré via un fallback interne (pas de consommation de crédits)
NO_AI=false

# Vercel Configuration (optionnel)
VERCEL_TOKEN=your_vercel_token_here

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Génération
MAX_SITES_PER_DAY=100
ZIP_STORAGE_PATH=/tmp/generated-sites

# Debug
NODE_ENV=development
